# Copy to .env for local development:  cp .env.example .env
#
# .env is gitignored. Real environment variables take precedence over it, so
# a deployment platform's own configuration is never overridden by this file.

# Signs the tokens that carry tenant identity. There is no default: anyone
# who knows this value can forge a token for any tenant. Generate a fresh one
# per environment, and never reuse the local one anywhere real.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-development-only-not-a-real-secret

# How long a sign-in lasts.
ACCESS_TOKEN_MINUTES=60

# --- database ---------------------------------------------------------------
# The defaults below match the docker run command in the README, so these can
# stay commented out locally.
#
# DATABASE_URL is the owner role: migrations, seeding, and the login endpoint,
# which must find a tenant before any tenant is known.
# APP_DATABASE_URL is dispatch_app, which row-level security applies to.
#
# DATABASE_URL=postgresql+psycopg://dispatch:dispatch@localhost:5433/dispatchledger
# APP_DATABASE_URL=postgresql+psycopg://dispatch_app:dispatch_app@localhost:5433/dispatchledger
#
# The customer portal. A third role, carrying a restrictive policy that
# narrows the tenant policy to a single customer -- the only login in the
# system reachable by someone outside the distributor.
# PORTAL_DATABASE_URL=postgresql+psycopg://dispatch_portal:dispatch_portal@localhost:5433/dispatchledger

# Passwords the migrations give the two non-owner roles. Left unset, the
# migrations use the development literals that match the URLs above. Set both
# on any database reachable from the internet -- ANALYTICS_DB_PASSWORD above
# all, because that role carries BYPASSRLS and every tenant policy is void
# for it.
#
# APP_DB_PASSWORD=
# ANALYTICS_DB_PASSWORD=
# PORTAL_DB_PASSWORD=

# Where dbt writes its marts. The Insights endpoint reads one table here.
# ANALYTICS_MARTS_SCHEMA=analytics_marts

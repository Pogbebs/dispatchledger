# Copy to .env and fill in. .env is gitignored.

# Free key from https://www.eia.gov/opendata/register.php
# Without it the price fetch task skips and the rest of the pipeline runs.
EIA_API_KEY = DFguRq08qnrdfAXjWePQYOy9ghCF5SJo8mjqG7v0

# host.docker.internal reaches the dispatch-db container from inside the
# Airflow containers on Docker Desktop.
ANALYTICS_DATABASE_URL = postgresql://dispatch_analytics:dispatch_analytics@host.docker.internal:5433/dispatchledger

AIRFLOW_UID = 50000
